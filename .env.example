# Application Settings
PROJECT_NAME="AI Multi-Disaster Risk Prediction & Early Warning System"
ENVIRONMENT="development"
DEBUG=True
PORT=8000

# Security
SECRET_KEY="your-super-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration
# Production PostgreSQL URL format: postgresql://username:password@localhost:5432/disaster_risk_db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/disaster_risk_db"
USE_SQLITE_FALLBACK=true

# External APIs
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"
OPEN_METEO_GEOCODING_URL="https://geocoding-api.open-meteo.com/v1"
# Optional fallback weather key if OpenWeatherMap is configured
OPENWEATHER_API_KEY=""

# CORS Configuration
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
