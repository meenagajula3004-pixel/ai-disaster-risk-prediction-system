# ==============================================================================
# AI Multi-Disaster Risk Prediction System - Environment Configuration
# ==============================================================================

# System Environment (development / production)
ENVIRONMENT=development
DEBUG=True
PORT=8000

# Database Configuration
# Use local SQLite or PostgreSQL connection string
DATABASE_URL=sqlite:///./disaster_risk.db
USE_SQLITE_FALLBACK=True

# JWT Authentication & Security
SECRET_KEY=your_secure_random_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMTP / Email Service Configuration (For OTP Dispatch)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_email_app_password_here
EMAIL_FROM=noreply@ai-disaster-risk.org
SMTP_TLS=True

# CAPTCHA / Human Verification Security (Cloudflare Turnstile or Google reCAPTCHA)
CAPTCHA_SITE_KEY=your_captcha_site_key_here
CAPTCHA_SECRET_KEY=your_captcha_secret_key_here
VITE_CAPTCHA_SITE_KEY=your_captcha_site_key_here

# External Weather Data Services
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1

# CORS Configuration (Comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
